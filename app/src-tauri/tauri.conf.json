{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex IG",
  "version": "0.6.21",
  "identifier": "com.paulocodex.codexig",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Codex IG",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "additionalBrowserArgs": "--disable-features=CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-gpu-shader-disk-cache"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRkEyNjZGMTdFNzdGRDYKUldUV2YrY1hieWI2WEd5dVNYcmRpenZVeFNkM3hFMW41anAxOWxGK1kxNUpHa0dEUWp2MG1oMksK",
      "endpoints": [
        "https://github.com/Paulothedeveloper/codex-ig-desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser"
      }
    }
  }
}